services:
    node-exporter:
        image: quay.io/prometheus/node-exporter:v1.12.0
        command:
            - --path.rootfs=/host
        network_mode: host
        pid: host
        restart: unless-stopped
        volumes:
            - /:/host:ro,rslave
  
    cadvisor:
        image: ghcr.io/google/cadvisor:v0.55.1
        restart: unless-stopped
        privileged: true
        devices:
            - /dev/kmsg:/dev/kmsg
        ports:
            - "8081:8080"
        volumes:
            - /:/rootfs:ro
            - /var/run:/var/run:ro
            - /sys:/sys:ro
            - /var/lib/docker:/var/lib/docker:ro
            - /dev/disk:/dev/disk:ro