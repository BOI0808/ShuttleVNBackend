global:
  scrape_interval: 15s

scrape_configs:
  - job_name: node-exporter
    static_configs:
      - targets:
          - "{{ hostvars['public_ec2'].ansible_host }}:9100"
          - "{{ hostvars['private_ec2'].ansible_host }}:9100"

  - job_name: cadvisor
    static_configs:
      - targets:
          - "{{ hostvars['public_ec2'].ansible_host }}:8081"
          - "{{ hostvars['private_ec2'].ansible_host }}:8081"