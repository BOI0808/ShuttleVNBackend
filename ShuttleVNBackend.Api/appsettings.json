{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://shuttlevn.vercel.app"
    ]
  },
  "ConnectionStrings": {},
  "EmailService": {
    "Provider": "Resend",
    "FromAddress": "noreply@example.com",
    "FromName": "ShuttleVN",
    "TimeoutSeconds": 30,
    "Smtp": {
      "Host": "",
      "Port": 587,
      "UseSsl": false
    }
  },
  "AccountSetup": {
    "FrontendBaseUrl": "",
    "SetPasswordPath": "/set-password"
  },
  "Assistant": {
    "BaseUrl": "",
    "Model": "",
    "TimeoutSeconds": 30,
    "MaxToolRounds": 3,
    "MaxToolCallsPerRound": 4,
    "MaxMessages": 20,
    "MaxMessageLength": 2000,
    "MaxReplyChars": 4000,
    "MaxTokens": 800,
    "Temperature": 0.3,
    "AvailabilityHorizonDays": 30,
    "ExtraBody": "{}"
  },
  "DefaultAdmin": {
    "FullName": "Admin",
    "Phone": "0987654321",
    "Email": "Admin@gmail.com"
  }
}
